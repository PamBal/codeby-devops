
Vagrant.configure("2") do |config|
  config.vm.define "bash-lab" do |vm|
    vm.vm.box = "bento/ubuntu-24.04"
    vm.vm.box_architecture = "arm64"
    vm.vm.hostname = "bash-lab"

    # Отключаем общую папку с Mac
    vm.vm.synced_folder ".", "/vagrant", disabled: true

    vm.vm.provider "virtualbox" do |vb|
      vb.name = "bash-lab"
      vb.memory = 2048
      vb.cpus = 2
    end
  end
end

