
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_architecture = "arm64"

  config.vm.synced_folder ".", "/vagrant", disabled: true

  # SERVER
  config.vm.define "server" do |server|
    server.vm.provision "shell", path: "provision/server.sh"
    server.vm.hostname = "server"
    server.vm.network "private_network", ip: "192.168.56.20"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "lesson8-server"
      vb.memory = 1024
      vb.cpus = 1
    end
  end

  # CLIENT
  config.vm.define "client" do |client|
    client.vm.provision "shell", path: "provision/client.sh"
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "192.168.56.21"

    client.vm.provider "virtualbox" do |vb|
      vb.name = "lesson8-client"
      vb.memory = 1024
      vb.cpus = 1
    end
  end
end

